{
    "elements": [
        {
            "type": "Label",
            "caption": "Bewässerungs Manager"
        },
        {
            "type": "NumberSpinner",
            "name": "DefaultDuration",
            "caption": "Standardlaufzeit in Minuten",
            "minimum": 1,
            "maximum": 240
        },
        {
            "type": "NumberSpinner",
            "name": "PauseBetweenValves",
            "caption": "Pause zwischen Ventilen in Sekunden",
            "minimum": 0,
            "maximum": 600
        },
        {
            "type": "NumberSpinner",
            "name": "MaxDuration",
            "caption": "Maximale Laufzeit pro Ventil in Minuten",
            "minimum": 1,
            "maximum": 240
        },
        {
            "type": "ExpansionPanel",
            "caption": "Ventile",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Nach dem Anlegen oder Ändern von Ventilen bitte Übernehmen drücken. Danach werden die Auswahlprofile und Gruppen-Auswahllisten neu aufgebaut."
                },
                {
                    "type": "List",
                    "name": "Valves",
                    "caption": "Ventile",
                    "rowCount": 10,
                    "add": true,
                    "delete": true,
                    "sort": {
                        "column": "Name",
                        "direction": "ascending"
                    },
                    "columns": [
                        {
                            "caption": "Aktiv",
                            "name": "Active",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Ventil-Variable",
                            "name": "VariableID",
                            "width": "260px",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable",
                                "requiredAction": 1,
                                "validVariableTypes": [
                                    0,
                                    1,
                                    2,
                                    3
                                ]
                            }
                        },
                        {
                            "caption": "Auto",
                            "name": "AutoValues",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Ein-Wert",
                            "name": "OnValue",
                            "width": "100px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Aus-Wert",
                            "name": "OffValue",
                            "width": "100px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Laufzeit Min.",
                            "name": "Duration",
                            "width": "120px",
                            "add": 10,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 240
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Gruppen",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Die auswählbaren Ventile werden aus der Ventilliste erzeugt. Wenn hier keine Ventile auswählbar sind: oben Ventile aktivieren, Variable auswählen, Übernehmen drücken, Instanz neu öffnen."
                },
                {
                    "type": "List",
                    "name": "Groups",
                    "caption": "Gruppen",
                    "rowCount": 10,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Aktiv",
                            "name": "Active",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Ventil 1",
                            "name": "Valve1",
                            "width": "160px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Ventil 2",
                            "name": "Valve2",
                            "width": "160px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Ventil 3",
                            "name": "Valve3",
                            "width": "160px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Ventil 4",
                            "name": "Valve4",
                            "width": "160px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Ventil 5",
                            "name": "Valve5",
                            "width": "160px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Ventil 6",
                            "name": "Valve6",
                            "width": "160px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Ventil 7",
                            "name": "Valve7",
                            "width": "160px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Ventil 8",
                            "name": "Valve8",
                            "width": "160px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        },
                        {
                            "caption": "Laufzeit Min.",
                            "name": "Duration",
                            "width": "120px",
                            "add": 10,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 240
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Alle Ventile ausschalten",
            "onClick": "BWM_EmergencyStop($id);"
        }
    ]
}
