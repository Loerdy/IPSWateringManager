{
    "elements": [
        {
            "type": "Label",
            "caption": "Bewässerungs Manager"
        },
        {
            "type": "NumberSpinner",
            "name": "DefaultDuration",
            "caption": "Standardlaufzeit in Minuten",
            "minimum": 1,
            "maximum": 240
        },
        {
            "type": "NumberSpinner",
            "name": "PauseBetweenValves",
            "caption": "Pause zwischen Ventilen in Sekunden",
            "minimum": 0,
            "maximum": 600
        },
        {
            "type": "NumberSpinner",
            "name": "MaxDuration",
            "caption": "Maximale Laufzeit pro Ventil in Minuten",
            "minimum": 1,
            "maximum": 240
        },
        {
            "type": "ExpansionPanel",
            "caption": "Ventile",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Hier werden die Variablen ausgewählt, welche die Ventile schalten. Bei Auto werden Ein-/Aus-Werte aus Variablentyp und Profil ermittelt."
                },
                {
                    "type": "List",
                    "name": "Valves",
                    "caption": "Ventile",
                    "rowCount": 10,
                    "add": true,
                    "delete": true,
                    "sort": {
                        "column": "Name",
                        "direction": "ascending"
                    },
                    "columns": [
                        {
                            "caption": "Aktiv",
                            "name": "Active",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "VariableID",
                            "name": "VariableID",
                            "width": "100px",
                            "add": 0
                        },
                        {
                            "caption": "Auto",
                            "name": "AutoValues",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Ein-Wert",
                            "name": "OnValue",
                            "width": "100px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Aus-Wert",
                            "name": "OffValue",
                            "width": "100px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Laufzeit Min.",
                            "name": "Duration",
                            "width": "120px",
                            "add": 10,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 240
                            }
                        }
                    ],
                    "form": [
                        {
                            "type": "CheckBox",
                            "name": "Active",
                            "caption": "Aktiv"
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "Name",
                            "caption": "Bezeichnung"
                        },
                        {
                            "type": "SelectVariable",
                            "name": "VariableID",
                            "caption": "Ventil-Variable",
                            "requiredAction": 1,
                            "validVariableTypes": [
                                0,
                                1,
                                2,
                                3
                            ]
                        },
                        {
                            "type": "CheckBox",
                            "name": "AutoValues",
                            "caption": "Ein-/Aus-Wert automatisch aus Variablentyp/Profil ermitteln"
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "OnValue",
                            "caption": "Ein-Wert manuell, optional"
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "OffValue",
                            "caption": "Aus-Wert manuell, optional"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "Duration",
                            "caption": "Standardlaufzeit in Minuten",
                            "minimum": 1,
                            "maximum": 240
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Gruppen",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Die Ventile der Gruppe werden aus den oben angelegten Ventilen ausgewählt. Nach dem Anlegen oder Ändern von Ventilen bitte erst Übernehmen drücken, dann die Gruppen bearbeiten."
                },
                {
                    "type": "List",
                    "name": "Groups",
                    "caption": "Gruppen",
                    "rowCount": 10,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Aktiv",
                            "name": "Active",
                            "width": "70px",
                            "add": true,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Ventil 1",
                            "name": "Valve1",
                            "width": "150px",
                            "add": ""
                        },
                        {
                            "caption": "Ventil 2",
                            "name": "Valve2",
                            "width": "150px",
                            "add": ""
                        },
                        {
                            "caption": "Ventil 3",
                            "name": "Valve3",
                            "width": "150px",
                            "add": ""
                        },
                        {
                            "caption": "Ventil 4",
                            "name": "Valve4",
                            "width": "150px",
                            "add": ""
                        },
                        {
                            "caption": "Laufzeit Min.",
                            "name": "Duration",
                            "width": "120px",
                            "add": 10,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 240
                            }
                        }
                    ],
                    "form": [
                        {
                            "type": "CheckBox",
                            "name": "Active",
                            "caption": "Aktiv"
                        },
                        {
                            "type": "ValidationTextBox",
                            "name": "Name",
                            "caption": "Gruppenname"
                        },
                        {
                            "type": "Select",
                            "name": "Valve1",
                            "caption": "Ventil 1",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "Valve2",
                            "caption": "Ventil 2",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "Valve3",
                            "caption": "Ventil 3",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "Valve4",
                            "caption": "Ventil 4",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "Valve5",
                            "caption": "Ventil 5",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "Valve6",
                            "caption": "Ventil 6",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "Valve7",
                            "caption": "Ventil 7",
                            "options": []
                        },
                        {
                            "type": "Select",
                            "name": "Valve8",
                            "caption": "Ventil 8",
                            "options": []
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "Duration",
                            "caption": "Laufzeit je Ventil in Minuten",
                            "minimum": 1,
                            "maximum": 240
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Alle Ventile ausschalten",
            "onClick": "BWM_EmergencyStop($id);"
        }
    ]
}